# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# --- E-posta (SMTP) ---
# Gmail icin: App Password olustur (normal sifre DEGIL)
SMTP_USER=senin.adresin@gmail.com
SMTP_PASS=uygulama-sifresi

# --- Randevu sistemi oturum cerezi (tarayicidan kopyalanan Cookie satiri) ---
# Her watcher, config.yaml icinde 'cookies_env' ile hangi degiskeni kullanacagini soyler.
MALTA_SESSION_COOKIE=buraya_tarayicidan_kopyaladigin_cookie_satiri
